# PHP dependencies
/vendor/
composer.lock

# Node dependencies
/node_modules/
package-lock.json

# Environment files
.env
.env.*
!.env.example

# Laravel storage (CRITICAL - keep this!)
/storage/*.key
/storage/framework/*
/storage/logs/*
/storage/private/*
/storage/app/private/*
!/storage/.gitkeep

# Cache and logs
/bootstrap/cache/
*.log
*.cache

# IDE files
/.vscode/
/.idea/
*.sublime-*

# OS files
.DS_Store
Thumbs.db

# Compiled assets
/public/css/
/public/js/
public/hot
public/hot-deploy-timestamp.txt
public/mix-manifest.json

# Testing
/.phpunit.cache
/.phpunit.result.cache
/coverage

# Temporary files
*.tmp
*.temp

# Session files (important!)
/storage/framework/sessions/*
/storage/framework/cache/*
/storage/framework/views/*

# SQLite
*.sqlite
*.sqlite-journal

# Uploaded PDFs (privacy!)
/storage/app/private/*

# Laravel debugbar
/storage/debugbar/*